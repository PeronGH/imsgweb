{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Stricter flags (not included in "strict")
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    // exactOptionalPropertyTypes is off: bun-plugin-svelte ships .ts source
    // (no .d.ts), so its code is checked with our flags and fails under it.
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,

    // Bun erases types without transpiling; ban enums/namespaces etc.
    "erasableSyntaxOnly": true
  }
}
